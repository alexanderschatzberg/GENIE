#!/bin/bash
# Pre-commit hook to prevent large files from being committed
# Files larger than MAX_SIZE will be rejected

MAX_SIZE=$((10 * 1024 * 1024))  # 10 MB in bytes
MAX_SIZE_HUMAN="10MB"

# Check staged files
large_files=()
while IFS= read -r -d '' file; do
    if [[ -f "$file" ]]; then
        size=$(wc -c < "$file" | tr -d ' ')
        if (( size > MAX_SIZE )); then
            large_files+=("$file ($(numfmt --to=iec-i --suffix=B "$size" 2>/dev/null || echo "${size} bytes"))")
        fi
    fi
done < <(git diff --cached --name-only -z)

if [[ ${#large_files[@]} -gt 0 ]]; then
    echo "ERROR: Attempting to commit files larger than $MAX_SIZE_HUMAN:"
    printf '  %s\n' "${large_files[@]}"
    echo ""
    echo "Consider using Git LFS for large files:"
    echo "  git lfs track \"path/to/large/files/**\""
    echo "  git add .gitattributes"
    exit 1
fi

exit 0
